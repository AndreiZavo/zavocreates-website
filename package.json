{
  "name": "zavocreates",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "wrangler dev --local --port 8787",
    "test:unit": "vitest run --config vitest.config.ts --passWithNoTests",
    "test:worker": "vitest run --config vitest.workers.config.ts --passWithNoTests",
    "test:e2e": "playwright test --project=e2e",
    "test:visual": "playwright test --project=visual --pass-with-no-tests",
    "check:links": "linkinator ./dist --recurse --silent",
    "lhci": "lhci autorun"
  },
  "dependencies": {
    "@fontsource/antonio": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "astro": "^7.4.8",
    "lenis": "^1.3.27",
    "motion": "^14.12.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@cloudflare/vitest-plugin": "^1.7.0",
    "@cloudflare/workers-types": "^5.20261110.1",
    "@lhci/cli": "^0.16.0",
    "@playwright/test": "^1.65.0",
    "linkinator": "^8.1.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12",
    "wrangler": "^4.160.0"
  }
}
