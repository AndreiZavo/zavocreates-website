---
import antonioHero from "@fontsource/antonio/files/antonio-latin-700-normal.woff2?url";
import interHero from "@fontsource/inter/files/inter-latin-300-normal.woff2?url";
import { getMotion, getSite, getTokens } from "../content/load";
import type { Effect, Transition } from "../content/schema";
import "../styles/tokens.css";
import "../styles/global.css";

interface Props {
  lang: "en" | "ro";
  title: string;
  description: string;
  path: string;
  alternates?: { lang: string; path: string }[];
  /** Ids of the content/motion.json effects whose data-motion elements are on this page. */
  motion?: string[];
}

const { lang, title, description, path, alternates = [], motion = [] } = Astro.props;
const site = getSite();
const abs = (p: string): string => new URL(p, site.url).href;
const canonical = abs(path);
const ogImage = abs(site.ogImage.src);

// Page fade: every number comes from the "page" effect in content/motion.json.
const pageEffect = getMotion("page");
if (pageEffect.kind !== "page") throw new Error('motion "page" must be a page effect');
const timing = (t: Transition): { duration: string; ease: string; delay: string } => {
  if (t.type !== "tween") throw new Error(`Page transition must be a tween, got "${t.type}"`);
  return { duration: `${t.duration}s`, ease: `cubic-bezier(${t.ease.join(", ")})`, delay: `${t.delay ?? 0}s` };
};
const opacity = (value: number | undefined, where: string): number => {
  if (value === undefined) throw new Error(`motion "page" ${where} has no opacity`);
  return value;
};
const enter = timing(pageEffect.enter.transition);
const exit = timing(pageEffect.exit.transition);
const pageVars = Object.entries({
  "--page-enter-duration": enter.duration,
  "--page-enter-ease": enter.ease,
  "--page-enter-delay": enter.delay,
  "--page-enter-from-opacity": opacity(pageEffect.enter.from.opacity, "enter.from"),
  "--page-enter-to-opacity": opacity(pageEffect.enter.to.opacity, "enter.to"),
  "--page-exit-duration": exit.duration,
  "--page-exit-ease": exit.ease,
  "--page-exit-delay": exit.delay,
  "--page-exit-to-opacity": opacity(pageEffect.exit.to.opacity, "exit.to"),
})
  .map(([name, value]) => `${name}:${value}`)
  .join(";");

// Motion runtime config: Smooth Scroll runs on every page, the rest is what the page declares.
const effects: Record<string, Effect> = Object.fromEntries(
  [...new Set(["smoothScroll", ...motion])].map((id) => [id, getMotion(id)]),
);
const motionConfig = JSON.stringify(effects).replaceAll("<", "\\u003c");
const media = (name: "tablet" | "phone"): string | undefined => getTokens().breakpoints.find((b) => b.name === name)?.media;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={abs(a.path)} />)}
    <link rel="icon" type="image/png" href={site.favicon.src} />
    <link rel="preload" as="font" type="font/woff2" href={antonioHero} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={interHero} crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(site.ogImage.width)} />
    <meta property="og:image:height" content={String(site.ogImage.height)} />
    <meta property="og:image:alt" content={site.ogImage.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <style is:inline set:html={`:root{${pageVars}}`} />
  </head>
  <body>
    <slot />
    <script is:inline type="application/json" id="motion-config" data-tablet={media("tablet")} data-phone={media("phone")} set:html={motionConfig} />
    <script>
      import { initMotion, type BreakpointMedia } from "../motion";
      import type { Effect } from "../content/schema";

      const config = document.getElementById("motion-config");
      if (config?.textContent) {
        const media: BreakpointMedia = {};
        if (config.dataset["tablet"]) media.tablet = config.dataset["tablet"];
        if (config.dataset["phone"]) media.phone = config.dataset["phone"];
        initMotion(JSON.parse(config.textContent) as Record<string, Effect>, media);
      }
    </script>
  </body>
</html>
