---
/**
 * Fixed film-grain layer behind every page (Framer "Noise BG", layout template).
 * Framer renders it as a CSS background tiled at noise.size (background-repeat/-size in its
 * published HTML), not a stretched image, so this is a decorative div with the same background.
 */
import { getSite } from "../content/load";

const { noise } = getSite();
const style = [
  `background-image:url(${noise.src})`,
  `background-repeat:${noise.repeat}`,
  `background-size:${noise.size}`,
  `opacity:${noise.opacity}`,
  `mix-blend-mode:${noise.blendMode}`,
].join(";");
---

<div class="noise" aria-hidden="true" style={style}></div>

<style is:global>
  .noise {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 0;
    width: 100%;
    height: 100vh;
    overflow: hidden;
    background-position: left top;
    pointer-events: none;
  }
</style>
