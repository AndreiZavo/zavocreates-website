---
/**
 * Contact form markup (Framer "Contact Form"). Behaviour (validation, Turnstile, fetch to
 * /api/contact, status messages) arrives in Task 9; without JS it posts to /api/contact.
 *
 * Contract: #contact-form, fields name / email / service (options from content) / message, a
 * div.cf-turnstile placeholder, a submit button and the [data-form-status] live region.
 */
import { getHome } from "../content/load";
import { svgMarkup } from "../content/images";

const { fields, serviceOptions } = getHome().contact;
const chevron = svgMarkup("/icons/iconoir-nav-arrow-down.svg");
---

<form id="contact-form" class="form" action="/api/contact" method="post">
  <div class="form__row">
    <label class="field">
      <span class="t-body-small field__label">{fields.name.label}</span>
      <input class="field__control" type="text" name="name" placeholder={fields.name.placeholder} autocomplete="name" required />
    </label>
    <label class="field">
      <span class="t-body-small field__label">{fields.email.label}</span>
      <input class="field__control" type="email" name="email" placeholder={fields.email.placeholder} autocomplete="email" required />
    </label>
  </div>
  <label class="field">
    <span class="t-body-small field__label">{fields.service.label}</span>
    <span class="field__select">
      <select class="field__control" name="service" required>
        <option value="" disabled selected>{fields.service.placeholder}</option>
        {serviceOptions.map((option) => <option value={option}>{option}</option>)}
      </select>
      <span class="field__chevron" aria-hidden="true" set:html={chevron} />
    </span>
  </label>
  <label class="field">
    <span class="t-body-small field__label">{fields.message.label}</span>
    <textarea class="field__control field__control--area" name="message" placeholder={fields.message.placeholder} required></textarea>
  </label>
  <div class="cf-turnstile"></div>
  <button class="submit" type="submit" data-motion="button.submit.hover" data-cursor="blend">
    <span class="submit__bg" data-motion-layer="Desktop/Color BG"></span>
    <span class="submit__text" data-motion-layer="Desktop/RichText">{fields.submit}</span>
  </button>
  <p class="t-body-small form__status" data-form-status role="status" aria-live="polite"></p>
</form>

<style is:global>
  .form {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
    width: 100%;
  }

  .form__row {
    display: flex;
    align-items: center;
    gap: 20px;
    width: 100%;
    overflow: hidden;
  }

  .form__row > .field {
    flex: 1 1 0;
  }

  .field {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    width: 100%;
  }

  .field__label {
    color: var(--color-purple-green);
  }

  .field__control {
    width: 100%;
    margin: 0;
    padding: 12px 20px;
    border: 0;
    border-radius: 99px;
    outline: none;
    background: var(--color-grey-50-dark);
    font-family: "Inter", sans-serif;
    font-size: 16px;
    font-weight: 300;
    line-height: 1.2em;
    letter-spacing: 0em;
    color: var(--color-grey-200-white);
    appearance: none;
  }

  .field__control::placeholder {
    color: var(--color-grey-150);
    opacity: 1;
  }

  /* Framer's focused border is drawn inside the field. */
  .field__control:focus-visible {
    box-shadow: inset 0 0 0 1px var(--color-purple-green);
  }

  .field__select {
    position: relative;
    display: flex;
    width: 100%;
    padding-right: 20px;
    border-radius: 99px;
    background: var(--color-grey-50-dark);
  }

  .field__select select {
    cursor: pointer;
  }

  .field__select select:invalid {
    color: var(--color-grey-150);
  }

  .field__chevron {
    position: absolute;
    top: 50%;
    right: 20px;
    display: flex;
    width: 16px;
    height: 16px;
    color: var(--color-grey-200-white);
    translate: 0 -50%;
    pointer-events: none;
  }

  .field__chevron svg {
    width: 100%;
    height: 100%;
  }

  .field__control--area {
    min-height: 140px;
    padding: 20px;
    border-radius: 20px;
    resize: vertical;
  }

  .cf-turnstile:empty,
  .form__status:empty {
    display: none;
  }

  .submit {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 6px 40px 10px;
    overflow: hidden;
    border: 0;
    border-radius: 99px;
    background: transparent;
    cursor: pointer;
  }

  .submit::after {
    content: "";
    position: absolute;
    inset: 0;
    border: 1px solid var(--color-purple-green);
    border-radius: inherit;
    pointer-events: none;
  }

  .submit__bg {
    position: absolute;
    bottom: -15px;
    left: -19px;
    z-index: 1;
    width: 15px;
    height: 19px;
    border-radius: 99px;
    background: var(--color-purple-green);
  }

  .submit__text {
    position: relative;
    z-index: 1;
    font-family: var(--text-heading-4-family);
    font-weight: var(--text-heading-4-weight);
    font-size: var(--text-heading-4-size);
    line-height: var(--text-heading-4-line);
    letter-spacing: var(--text-heading-4-tracking);
    text-transform: var(--text-heading-4-transform);
    color: var(--color-purple-green);
  }

  /* Tablet & phone: the filled "Tablet & Phone" variant. */
  @media (max-width: 1199.98px) {
    .submit {
      background: var(--color-purple-green);
    }

    .submit::after {
      content: none;
    }

    .submit__text {
      color: var(--color-white-dark);
    }
  }

  @media (max-width: 809.98px) {
    .form__row {
      flex-direction: column;
    }

    .form__row > .field {
      flex: none;
    }

    .submit {
      width: 100%;
    }
  }
</style>
