# Build-time variables read by Astro (copy to .env to override locally; .env is git-ignored).
# Turnstile sitekey for the contact form. This is Cloudflare's always-pass test key
# (https://developers.cloudflare.com/turnstile/troubleshooting/testing/), which the build also
# uses when the variable is unset. Production builds set the real sitekey (public, not a secret).
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Cloudflare Web Analytics site token (public, from the Web Analytics "Manage site" snippet).
# Unset or empty: the beacon is left out of every page (local dev, tests, CI).
PUBLIC_CF_ANALYTICS_TOKEN=
